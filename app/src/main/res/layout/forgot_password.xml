<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/cons_lay_forg_pass">


    <TextView
        android:id="@+id/reset_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/cons_lay_forg_pass"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:layout_marginLeft="36dp"
        android:fontFamily="@font/fauna_one"
        android:layout_marginBottom="8dp"
        android:textColor="@color/colorPrimary"
        android:textSize="24sp"
        android:textAlignment="center"
        android:gravity="center"
        android:text="@string/reset_password_pane"
        app:layout_constraintLeft_toLeftOf="@+id/cons_lay_forg_pass"
        app:layout_constraintRight_toRightOf="@+id/cons_lay_forg_pass"/>

    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/cons_lay_forg_pass"
        app:layout_constraintRight_toRightOf="@+id/cons_lay_forg_pass"
        android:layout_margin="16dp"
        android:drawableStart="@drawable/ic_email_color"
        android:fontFamily="@font/fauna_one"
        android:inputType="textEmailAddress"
        android:textSize="13sp"
        android:hint="@string/email_hint"
        android:id="@+id/email_app_edt_forg_pass"
        app:layout_constraintTop_toBottomOf="@id/reset_label"/>











</androidx.constraintlayout.widget.ConstraintLayout>